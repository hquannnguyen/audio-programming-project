{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build Raylib Project Flat",
            "command": "C:/mingw64/bin/g++.exe", 
            "args": [
                "-g",
                "${workspaceFolder}/*.cpp",
                "-I", "${workspaceFolder}/lib",
                "-L", "${workspaceFolder}/lib",
                "-o", "${workspaceFolder}/AudioApp.exe",
                "-O1",
                "-Wall",
                "-Wno-missing-braces",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task biên dịch dự án Raylib trực tiếp trong thư mục gốc"
        }
    ]
}